{
  "routes": [
    {
      "route": "/api/*",
      "headers": {
        "Cache-Control": "no-store, private",
        "X-Content-Type-Options": "nosniff"
      }
    },
    {
      "route": "/dashboard",
      "rewrite": "/pages/dashboard.html"
    },
    {
      "route": "/history",
      "rewrite": "/pages/history.html"
    },
    {
      "route": "/viewer",
      "rewrite": "/pages/viewer.html"
    },
    {
      "route": "/governance",
      "rewrite": "/pages/governance.html"
    },
    {
      "route": "/profile",
      "rewrite": "/pages/profile.html"
    },
    {
      "route": "/pricing",
      "rewrite": "/pages/pricing.html"
    },
    {
      "route": "/contact",
      "rewrite": "/pages/contact.html"
    },
    {
      "route": "/admin",
      "rewrite": "/pages/admin.html"
    },
    {
      "route": "/login",
      "rewrite": "/pages/login.html"
    },
    {
      "route": "/tools",
      "rewrite": "/pages/tools.html"
    },
    {
      "route": "/media-redaction",
      "rewrite": "/pages/media-redaction.html"
    },
    {
      "route": "/tool",
      "rewrite": "/pages/tool.html"
    },
    {
      "route": "/advanced-tool",
      "rewrite": "/pages/advanced-tool.html"
    },
    {
      "route": "/",
      "rewrite": "/index.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/pages/login.html",
    "exclude": [
      "/css/*",
      "/js/*",
      "/assets/*",
      "/vendor/*",
      "/*.json",
      "/*.ico",
      "/*.png",
      "/*.svg",
      "/robots.txt"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=()",
    "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet, noimageindex",
    "Cache-Control": "no-store, no-cache, must-revalidate, private",
    "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; frame-src 'self' blob:; connect-src 'self' https://*.azure.com https://*.azurewebsites.net https://*.powerplatform.com https://*.powerautomate.com https://*.supabase.co https://*.blob.core.windows.net; font-src 'self' data:; object-src 'none'; media-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;",
    "X-Permitted-Cross-Domain-Policies": "none",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "X-DNS-Prefetch-Control": "off",
    "Origin-Agent-Cluster": "?1"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/pages/login.html",
      "statusCode": 200
    }
  },
  "mimeTypes": {
    ".json": "application/json",
    ".css": "text/css",
    ".js": "application/javascript",
    ".svg": "image/svg+xml"
  }
}
