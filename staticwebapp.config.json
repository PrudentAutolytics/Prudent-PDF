{
  "routes": [
    { "route": "/dashboard", "rewrite": "/pages/dashboard.html" },
    { "route": "/history",   "rewrite": "/pages/history.html"   },
    { "route": "/viewer",    "rewrite": "/pages/viewer.html"     },
    { "route": "/pricing",   "rewrite": "/pages/pricing.html"   },
    { "route": "/contact",   "rewrite": "/pages/contact.html"   },
    { "route": "/admin",     "rewrite": "/pages/admin.html"     },
    { "route": "/login",     "rewrite": "/pages/login.html"     },
    { "route": "/",          "rewrite": "/index.html"           }
  ],
  "navigationFallback": {
    "rewrite": "/pages/login.html",
    "exclude": ["/css/*", "/js/*", "/assets/*", "/*.json", "/*.ico", "/*.png", "/*.svg"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".css":  "text/css",
    ".js":   "application/javascript",
    ".svg":  "image/svg+xml"
  }
}