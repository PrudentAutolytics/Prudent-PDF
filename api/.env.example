# Copy to .env for local development ONLY. Never commit .env.
# In production, set ALL of these as Azure Static Web App application
# settings (Portal -> Environment variables). No defaults exist in code;
# the API fails closed if a required setting is missing.

# PostgreSQL (Supabase pooler)
PG_HOST=your-pooler-host.pooler.supabase.com
PG_PORT=6543
PG_DATABASE=postgres
PG_USER=postgres.yourproject
PG_PASSWORD=REPLACE_ME
# Leave unset (or "true") in production. Only set false while debugging TLS.
# PG_SSL_REJECT_UNAUTHORIZED=true

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=yourstorageaccount
AZURE_STORAGE_KEY=REPLACE_ME
AZURE_UPLOAD_CONTAINER=prudent-uploads
AZURE_RESULTS_CONTAINER=prudent-results

# Power Automate flow trigger URLs (contain SAS signatures — treat as secrets)
PA_EMAIL_SEND=REPLACE_ME
PA_JOB_SUBMIT_FLOW=REPLACE_ME

# App secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_ME_64_CHAR_RANDOM_HEX
PA_CALLBACK_SECRET=REPLACE_ME_RANDOM_STRING_MIN_16_CHARS

# App
APP_URL=https://your-app.azurestaticapps.net
ALLOWED_ORIGINS=https://your-app.azurestaticapps.net
ADMIN_EMAILS=kabileshvijayakumar@prudentautolytics.com
